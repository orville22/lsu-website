generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Status {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}
enum LessonDepth {
  SHORT
  FULL
}
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
model Discipline {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  categories Category[]
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  questions Question[]
  lessons Lesson[]
  @@index([disciplineId])
}
model Lesson {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  subtopic String @default("")
  difficulty Difficulty @default(BEGINNER)
  readingMinutes Int @default(5)
  depth LessonDepth @default(FULL)
  listAsUpcoming Boolean @default(false)
  objectives String[]
  blocks Json
  takeaways String[]
  references Json
  status Status @default(DRAFT)
  isDemo Boolean @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  author String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions QuestionLesson[]
  @@index([status, categoryId])
}
model Question {
  id String @id @default(cuid())
  text String
  type String @default("SINGLE_BEST_ANSWER")
  explanation String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  subtopic String @default("")
  difficulty Difficulty @default(BEGINNER)
  tags String[]
  options AnswerOption[]
  references Json
  lessons QuestionLesson[]
  status Status @default(DRAFT)
  isDemo Boolean @default(false)
  author String @default("")
  reviewedBy String?
  reviewedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, reviewedAt, categoryId, difficulty])
}
model AnswerOption {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  text String
  isCorrect Boolean @default(false)
  explanation String @default("")
  position Int
  @@unique([questionId, position])
}
model QuestionLesson {
  questionId String
  lessonId String
  anchor String @default("")
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade)
  @@id([questionId, lessonId])
}
model Learner {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  attempts Attempt[]
}
model Attempt {
  id String @id @default(cuid())
  ownerHash String
  learnerId String?
  learner Learner? @relation(fields:[learnerId], references:[id])
  mode String @default("PRACTICE")
  isDemo Boolean @default(false)
  questionIds String[]
  snapshot Json
  answers Json @default("{}")
  result Json?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerHash, createdAt])
}
model AdminSession {
  tokenHash String @id
  actor String
  expiresAt DateTime
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  entity String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}
/// Email-update subscribers. Double opt-in: a row counts only once CONFIRMED.
/// No IP address or browser data is stored (see the privacy page).
model Subscriber {
  id String @id @default(cuid())
  /// Trimmed and lower-cased.
  email String @unique
  status SubscriberStatus @default(PENDING)
  /// Where the form was submitted, e.g. "home" or "lesson:<slug>".
  source String @default("")
  /// Exact consent statement shown next to the form when the person signed up.
  consentText String @default("")
  /// SHA-256 of the single-use confirmation token. Cleared once confirmed.
  confirmTokenHash String? @unique
  confirmExpiresAt DateTime?
  confirmSentAt DateTime?
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}
enum ReviewerStatus {
  REQUESTED
  INVITED
  ACTIVE
  REVOKED
  DECLINED
}
/// Invited volunteer reviewers. While the site is "coming soon", a reviewer's
/// personal invite link sets the lsu_reviewer cookie, which lets them see the
/// whole site and leave feedback. Only the link token's SHA-256 is stored.
model Reviewer {
  id String @id @default(cuid())
  name String
  /// Trimmed and lower-cased.
  email String @unique
  /// How they describe themselves, e.g. "Student" or "Practising scientist".
  role String @default("")
  /// What they wrote when asking to review, if they used the request form.
  note String @default("")
  /// "request" (public form) or "admin" (added by an administrator).
  source String @default("admin")
  status ReviewerStatus @default(REQUESTED)
  tokenHash String? @unique
  invitedAt DateTime?
  firstSeenAt DateTime?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feedback Feedback[]
  @@index([status, createdAt])
}
/// Feedback left with the on-page button by a reviewer or an administrator.
model Feedback {
  id String @id @default(cuid())
  reviewerId String?
  reviewer Reviewer? @relation(fields:[reviewerId], references:[id], onDelete:SetNull)
  /// Set when an administrator left it.
  actor String?
  /// Path of the page the feedback is about, e.g. /learn/clinical-chemistry/electrolytes/c1-2-...
  path String
  /// "page" for the guided five-question review.
  kind String @default("page")
  /// Answer to "How clear was this page?" (1–5), copied out for sorting.
  rating Int?
  /// All answers, keyed by question id (see src/lib/reviewers.ts).
  answers Json @default("{}")
  /// Free-text answers joined, for search and CSV export.
  comment String @default("")
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([path])
}
