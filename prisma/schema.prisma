generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Status {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}
enum LessonDepth {
  SHORT
  FULL
}
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
model Discipline {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  categories Category[]
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  questions Question[]
  lessons Lesson[]
  @@index([disciplineId])
}
model Lesson {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  subtopic String @default("")
  difficulty Difficulty @default(BEGINNER)
  readingMinutes Int @default(5)
  depth LessonDepth @default(FULL)
  listAsUpcoming Boolean @default(false)
  objectives String[]
  blocks Json
  takeaways String[]
  references Json
  status Status @default(DRAFT)
  isDemo Boolean @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  author String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions QuestionLesson[]
  @@index([status, categoryId])
}
model Question {
  id String @id @default(cuid())
  text String
  type String @default("SINGLE_BEST_ANSWER")
  explanation String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  subtopic String @default("")
  difficulty Difficulty @default(BEGINNER)
  tags String[]
  options AnswerOption[]
  references Json
  lessons QuestionLesson[]
  status Status @default(DRAFT)
  isDemo Boolean @default(false)
  author String @default("")
  reviewedBy String?
  reviewedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, reviewedAt, categoryId, difficulty])
}
model AnswerOption {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  text String
  isCorrect Boolean @default(false)
  explanation String @default("")
  position Int
  @@unique([questionId, position])
}
model QuestionLesson {
  questionId String
  lessonId String
  anchor String @default("")
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade)
  @@id([questionId, lessonId])
}
model Learner {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  attempts Attempt[]
}
model Attempt {
  id String @id @default(cuid())
  ownerHash String
  learnerId String?
  learner Learner? @relation(fields:[learnerId], references:[id])
  mode String @default("PRACTICE")
  isDemo Boolean @default(false)
  questionIds String[]
  snapshot Json
  answers Json @default("{}")
  result Json?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerHash, createdAt])
}
model AdminSession {
  tokenHash String @id
  actor String
  expiresAt DateTime
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  entity String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}
/// Email-update subscribers. Double opt-in: a row counts only once CONFIRMED.
/// No IP address or browser data is stored (see the privacy page).
model Subscriber {
  id String @id @default(cuid())
  /// Trimmed and lower-cased.
  email String @unique
  status SubscriberStatus @default(PENDING)
  /// Where the form was submitted, e.g. "home" or "lesson:<slug>".
  source String @default("")
  /// Exact consent statement shown next to the form when the person signed up.
  consentText String @default("")
  /// SHA-256 of the single-use confirmation token. Cleared once confirmed.
  confirmTokenHash String? @unique
  confirmExpiresAt DateTime?
  confirmSentAt DateTime?
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}
enum ReviewerStatus {
  REQUESTED
  APPROVED
  DECLINED
  REVOKED
}
/// Volunteer reviewers. A request is stored as REQUESTED; approving it emails a
/// personal access link. Only the link token's SHA-256 is stored.
model Reviewer {
  id String @id @default(cuid())
  name String
  /// Trimmed and lower-cased.
  email String @unique
  /// STUDENT, SCIENTIST, EDUCATOR or OTHER.
  role String
  country String @default("")
  /// Optional note from the volunteer (background, interests).
  note String @default("")
  /// Exact consent statement shown on the request form.
  consentText String @default("")
  /// Agreed to be thanked by name on the site.
  creditConsent Boolean @default(false)
  status ReviewerStatus @default(REQUESTED)
  /// "learner" or "expert": which feedback questions they see.
  track String @default("learner")
  accessTokenHash String? @unique
  invitedAt DateTime?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feedback Feedback[]
  @@index([status, updatedAt])
}
enum FeedbackStatus {
  OPEN
  RESOLVED
}
/// Page feedback: structured reviews from reviewers, and anonymous error reports.
model Feedback {
  id String @id @default(cuid())
  /// REVIEW (reviewer, guided questions) or ERROR (anyone, free text).
  kind String
  reviewerId String?
  reviewer Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  path String
  pageTitle String @default("")
  /// 1 to 5.
  clarity Int?
  /// TOO_BASIC, ABOUT_RIGHT or TOO_ADVANCED.
  level String?
  /// Question set used: "learner" or "expert" (the reviewer's track when sent).
  track String @default("learner")
  accuracy String @default("")
  /// Expert only: anything out of date against current guidelines or practice.
  currency String @default("")
  /// Expert only: references that don't support the claims they're attached to.
  references String @default("")
  illustrations String @default("")
  missing String @default("")
  comment String @default("")
  status FeedbackStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([path])
}
