DATABASE_URL="postgresql://lsu:CHANGE_ME@localhost:5432/lsu"
SITE_URL="http://localhost:3000"
ADMIN_USERNAME="admin"
# Generate with npm run admin:password; paste the generated scrypt hash here.
ADMIN_PASSWORD_HASH=""
# At least 32 random characters. Generate: openssl rand -hex 32
SESSION_SECRET=""
# Only turn on when your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY="false"
QUIZ_BEGINNER_WEIGHT="0.4"
QUIZ_INTERMEDIATE_WEIGHT="0.4"
QUIZ_ADVANCED_WEIGHT="0.2"

# Anonymous quiz attempts are deleted after this many days (daily Vercel Cron, see vercel.json).
ANONYMOUS_RETENTION_DAYS="30"
# Vercel sends this as a Bearer token to /api/cron/cleanup. Generate: openssl rand -hex 32
CRON_SECRET=""

# Email sign-up (double opt-in) through Resend. The sign-up form stays hidden until all three are set.
# API key from resend.com → API Keys (sending access is enough).
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. labscienceunfiltered.com.
EMAIL_FROM="Lab Science Unfiltered <updates@labscienceunfiltered.com>"
# Signs unsubscribe links. At least 32 random characters: openssl rand -hex 32
# Changing it breaks unsubscribe links in emails already sent, so set it once.
EMAIL_TOKEN_SECRET=""
