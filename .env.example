DATABASE_URL="postgresql://lsu:CHANGE_ME@localhost:5432/lsu"
SITE_URL="http://localhost:3000"
ADMIN_USERNAME="admin"
# Generate with npm run admin:password; paste the generated scrypt hash here.
ADMIN_PASSWORD_HASH=""
# At least 32 random characters. Generate: openssl rand -hex 32
SESSION_SECRET=""
# Only turn on when your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY="false"
QUIZ_BEGINNER_WEIGHT="0.4"
QUIZ_INTERMEDIATE_WEIGHT="0.4"
QUIZ_ADVANCED_WEIGHT="0.2"

# Anonymous quiz attempts are deleted after this many days (daily Vercel Cron, see vercel.json).
ANONYMOUS_RETENTION_DAYS="30"
# Vercel sends this as a Bearer token to /api/cron/cleanup. Generate: openssl rand -hex 32
CRON_SECRET=""
