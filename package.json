{
  "name": "lab-science-unfiltered",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:password": "node scripts/password.mjs",
    "db:cleanup": "node --import tsx scripts/cleanup.ts",
    "db:remove-demo": "node --import tsx scripts/remove-demo-content.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "format": "prettier --write src prisma scripts tests docs README.md",
    "format:check": "prettier --check src prisma scripts tests docs README.md"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "katex": "0.19.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module"
}
